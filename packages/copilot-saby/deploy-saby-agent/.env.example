# Saby agent environment (copy to .env and adjust).

# Base URL of the governed Saby backend REST API. The agent calls
# /v1/copilot/tools/:name/call and /v1/copilot/actions/:id on this host.
# A trailing "/v1" is tolerated and normalized.
SABY_BACKEND_URL=https://api.saby.ai

# Web app used for `saby auth login` browser sign-in.
SABY_FRONTEND_URL=https://app.saby.ai

# Directory the launcher uses for its auth session (default ~/.saby).
SABY_HOME=~/.saby

# Optional overrides. Auto-detected when the launcher stays inside the bundle:
# SABY_BUNDLE_DIR=<path to bundle root>
# SABY_OPENCODE_CMD=<path to opencode-saby binary>